archivos <- list.files(pattern = ".csv")
for (archivo in archivos) {
print(archivo)
print(head(read_csv(archivo, col_types = cols(.default = "c")))) # Cargar como texto para inspección
}
# Variables que queremos revisar en cada archivo
variables_a_revisar <- c("p6_4", "p6_8", "p6_9", "p6_13",
"p7_6_1", "p7_6_2", "p7_6_3", "p7_6_4",
"p7_6_5", "p7_6_6", "p7_6_7", "p7_6_8",
"ent", "fac_ele")
# Revisar solo las variables seleccionadas en cada archivo CSV
for (archivo in archivos) {
print(paste("Archivo:", archivo))
# Leer archivo como texto para evitar conversiones automáticas
datos <- read_csv(archivo, col_types = cols(.default = "c"))
# Verificar si el archivo contiene las variables de interés
vars_presentes <- intersect(variables_a_revisar, names(datos))
if (length(vars_presentes) > 0) {
print(paste("Variables encontradas en", archivo, ":", paste(vars_presentes, collapse = ", ")))
print(head(datos %>% select(all_of(vars_presentes)))) # Mostrar solo las variables seleccionadas
} else {
print(paste("Ninguna variable de interés encontrada en", archivo))
}
}
archivos <- list.files(pattern = ".csv")
variables_a_revisar <- c("p6_4", "p6_8", "p6_9", "p6_13",
"p7_6_1", "p7_6_2", "p7_6_3", "p7_6_4",
"p7_6_5", "p7_6_6", "p7_6_7", "p7_6_8",
"ent", "fac_ele")
for (archivo in archivos) {
print(paste("Archivo:", archivo))
datos <- read_csv(archivo, col_types = cols(.default = "c"))
# Limpiar nombres de las columnas eliminando espacios y poniendo todo en minúsculas
nombres_limpios <- str_trim(tolower(names(datos)))
# Variables presentes después de limpiar nombres
vars_presentes <- intersect(variables_a_revisar, nombres_limpios)
if (length(vars_presentes) > 0) {
print(paste("Variables encontradas en", archivo, ":", paste(vars_presentes, collapse = ", ")))
print(head(datos %>% rename_with(~str_trim(tolower(.))) %>% select(all_of(vars_presentes))))
} else {
print(paste("Ninguna variable de interés encontrada en", archivo))
}
}
# Archivo específico a revisar
archivo <- "TMODULO.csv"
# Variables que queremos revisar
variables_a_revisar <- c("p6_4", "p6_8", "p6_9", "p6_13",
"p7_6_1", "p7_6_2", "p7_6_3", "p7_6_4",
"p7_6_5", "p7_6_6", "p7_6_7", "p7_6_8",
"ent", "fac_ele")
# Leer archivo CSV como texto para evitar conversiones automáticas
if (file.exists(archivo)) {
print(paste("Revisando archivo:", archivo))
datos <- read_csv(archivo, col_types = cols(.default = "c"))
# Limpiar nombres de columnas: eliminar espacios y poner en minúsculas
nombres_limpios <- str_trim(tolower(names(datos)))
# Variables presentes después de limpiar nombres
vars_presentes <- intersect(variables_a_revisar, nombres_limpios)
if (length(vars_presentes) > 0) {
print(paste("Variables encontradas en", archivo, ":", paste(vars_presentes, collapse = ", ")))
print(head(datos %>% rename_with(~str_trim(tolower(.))) %>% select(all_of(vars_presentes))))
} else {
print(paste("Ninguna variable de interés encontrada en", archivo))
print("Nombres de columnas disponibles en el archivo:")
print(names(datos))  # Muestra los nombres de las columnas para depuración
}
} else {
print(paste("El archivo", archivo, "no existe en el directorio actual."))
}
