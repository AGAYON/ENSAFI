library(statnet)
#elegir el csv creado
archivo <- file.choose()
covid <- read_csv(archivo)
covid$daily_recovered <- covid$daily_recovered - covid$daily_deaths
total_population <-126014024
covid_unico <- covid %>%
group_by(FECHA_INGRESO) %>%
summarise(
daily_confirmed = sum(daily_confirmed),
daily_recovered = sum(daily_recovered),
daily_deaths = sum(daily_deaths),
) %>%
arrange(FECHA_INGRESO)  # Ordenar por fecha
covid_unico <- covid_unico %>% mutate(
cum_confirmed = cumsum(covid_unico$daily_confirmed),
cum_deaths = cumsum(covid_unico$daily_deaths),
cum_recovered = cumsum(covid_unico$daily_recovered),
S = total_population - cum_confirmed
)
# Calcular el número de infectados actuales (I)
covid_unico$I <- covid_unico$cum_confirmed - covid_unico$cum_recovered - covid_unico$cum_deaths
View(covid_unico)
# Crear las variables necesarias dentro del dataframe utilizando tidyverse
df <- df %>%
mutate(
infectados = cum_confirmed - cum_recovered - cum_deaths, # Calcular infectados
beta = daily_confirmed / (susceptibles * infectados),    # Tasa de transmisión
gamma = daily_recovered / infectados                    # Tasa de recuperación
)
