library(pbapply)
# Paso 2: Definir parámetros
N <- 54  # Total de elementos
n <- 6   # Tamaño de combinaciones más pequeñas
m <- 8   # Tamaño de combinaciones más grandes
# Paso 3: Generar iteradores para combinaciones dinámicas
iter_n <- iterpc(N, n, ordered = FALSE)  # Iterador para combinaciones de tamaño n
iter_m <- iterpc(N, m, ordered = FALSE)  # Iterador para combinaciones de tamaño m
# Paso 4: Configurar paralelización
num_cores <- detectCores() - 1  # Detectar núcleos disponibles
cl <- makeCluster(num_cores)    # Crear un cluster con núcleos disponibles
# Exportar variables y funciones al cluster
clusterExport(cl, varlist = c("iterpc", "iter_n", "iter_m", "n", "m", "N"), envir = environment())
# Definir la función para agrupar dinámicamente
agrupar_combinaciones <- function(index_m) {
comb_m <- getnext(iter_m, index_m)  # Obtener la combinación m actual
# Crear un iterador temporal para las combinaciones n
iter_n_local <- iterpc(N, n, ordered = FALSE)
# Verificar qué combinaciones n están contenidas en comb_m
resultado <- c()
for (i in seq_len(getlength(iter_n_local))) {
comb_n <- getnext(iter_n_local)
if (all(comb_n %in% comb_m)) {
resultado <- c(resultado, i)
}
}
return(resultado)
}
# Paso 5: Procesar en paralelo con barra de progreso
agrupamientos <- pblapply(seq_len(getlength(iter_m)), agrupar_combinaciones, cl = cl)
# Paso 2: Definir parámetros
N <- 54  # Total de elementos
n <- 6   # Tamaño de combinaciones más pequeñas
m <- 8   # Tamaño de combinaciones más grandes
block_size <- 1000  # Tamaño del bloque para procesamiento
# Paso 3: Generar iteradores para combinaciones dinámicas
iter_n <- iterpc(N, n, ordered = FALSE)  # Iterador para combinaciones de tamaño n
iter_m <- iterpc(N, m, ordered = FALSE)  # Iterador para combinaciones de tamaño m
# Paso 4: Configurar paralelización
num_cores <- detectCores() - 1  # Detectar núcleos disponibles
cl <- makeCluster(num_cores)    # Crear un cluster con núcleos disponibles
# Exportar variables y funciones al cluster
clusterExport(cl, varlist = c("iterpc", "iter_n", "iter_m", "n", "m", "N"), envir = environment())
# Función para agrupar combinaciones dinámicamente en un bloque
procesar_bloque <- function(indices_m) {
resultados <- list()
for (index in indices_m) {
comb_m <- getnext(iter_m, index)  # Obtener la combinación m actual
# Crear un iterador temporal para las combinaciones n
iter_n_local <- iterpc(N, n, ordered = FALSE)
# Verificar qué combinaciones n están contenidas en comb_m
resultado <- c()
for (i in seq_len(getlength(iter_n_local))) {
comb_n <- getnext(iter_n_local)
if (all(comb_n %in% comb_m)) {
resultado <- c(resultado, i)
}
}
resultados[[index]] <- resultado
}
return(do.call(rbind, resultados))
}
# Paso 5: Procesar combinaciones en bloques con barra de progreso
total_m <- getlength(iter_m)
bloques <- split(seq_len(total_m), ceiling(seq_along(seq_len(total_m)) / block_size))
# Paso 1: Cargar librerías
library(iterpc)
library(pbapply)
# Paso 2: Definir parámetros
N <- 54  # Total de elementos
n <- 6   # Tamaño de combinaciones más pequeñas
m <- 8   # Tamaño de combinaciones más grandes
# Paso 3: Crear iteradores para combinaciones dinámicas
iter_n <- iterpc(N, n, ordered = FALSE)  # Iterador para combinaciones de tamaño n
iter_m <- iterpc(N, m, ordered = FALSE)  # Iterador para combinaciones de tamaño m
# Función para procesar una combinación m
procesar_combinacion_m <- function(index_m) {
comb_m <- getnext(iter_m)  # Obtener la combinación m actual
# Crear un iterador para combinaciones n (reiniciado cada vez)
iter_n_local <- iterpc(N, n, ordered = FALSE)
# Verificar qué combinaciones n están contenidas en comb_m
resultado <- c()
for (i in seq_len(getlength(iter_n_local))) {
comb_n <- getnext(iter_n_local)
if (all(comb_n %in% comb_m)) {
resultado <- c(resultado, i)
}
}
return(resultado)
}
# Paso 4: Procesar combinaciones con barra de progreso
# Iteramos sobre las combinaciones m una por una
total_m <- getlength(iter_m)  # Total de combinaciones m
agrupamientos <- pblapply(seq_len(total_m), procesar_combinacion_m)
