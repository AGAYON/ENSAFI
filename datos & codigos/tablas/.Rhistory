#CREACIÓN DE TABLA TASA INTERES
#Extraemos el archivo
archivo = file.choose()
data = read.csv(archivo)
tasa_interes = data %>%
arrange(fecha) %>%
mutate(
mes = month(fecha),
año = year(fecha),
es_inicio_trimestre = ifelse(mes %in% c(1, 4, 7, 10), 1, 0),
trimestre = ifelse(
row_number() == 1 | (lag(año) != año | lag(mes) %in% c(1, 4, 7, 10)),
1,
0
)
) %>%
select(-mes, -año, -es_inicio_trimestre)
View(tasa_interes)
tasa_interes = data %>%
arrange(fecha) %>%
mutate(
mes = month(fecha),
año = year(fecha),
trimestre = ifelse(
row_number() == 1 |  # La primera observación siempre es 1
(mes %in% c(1, 4, 7, 10) & (lag(mes, default = 0) != mes | lag(año, default = 0) != año)),
1,
0
)
) %>%
select(-mes, -año)
View(tasa_interes)
str(tasa_interes)
tasa_interes = data %>%
mutate(fecha = as.Date(fecha)) %>%  # Convertir a Date
arrange(fecha) %>%  # Ahora sí, ordenar correctamente
mutate(
mes = month(fecha),
año = year(fecha),
trimestre = ifelse(
row_number() == 1 |  # La primera observación siempre es 1
(mes %in% c(1, 4, 7, 10) & (lag(mes, default = 0) != mes | lag(año, default = 0) != año)),
1,
0
)
) %>%
select(-mes, -año)
View(tasa_interes)
head(tasa_interes, 10)
